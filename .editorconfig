# Editor and code style rules. The rules and their reasons are documented in
# docs/standards/code-style.md and docs/standards/naming.md; change them there first.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

[*.cs]
#### Formatting is owned by CSharpier (S-01) ####
dotnet_diagnostic.IDE0055.severity = none

#### Code style (code-style §4.3) ####
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = error
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_diagnostic.IDE0003.severity = warning

dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_diagnostic.IDE0049.severity = warning

dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_diagnostic.IDE0041.severity = warning

dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning

csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:warning
dotnet_diagnostic.IDE0019.severity = warning
dotnet_diagnostic.IDE0020.severity = warning
dotnet_diagnostic.IDE0066.severity = warning

csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:warning
dotnet_diagnostic.IDE0022.severity = warning
dotnet_diagnostic.IDE0025.severity = warning

dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

#### Naming (naming §4.1) ####
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_prefix_pascal.required_prefix = I
dotnet_naming_style.i_prefix_pascal.capitalization = pascal_case
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_prefix_pascal
dotnet_naming_rule.interfaces_start_with_i.severity = error

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_style.t_prefix_pascal.required_prefix = T
dotnet_naming_style.t_prefix_pascal.capitalization = pascal_case
dotnet_naming_rule.type_parameters_start_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_start_with_t.style = t_prefix_pascal
dotnet_naming_rule.type_parameters_start_with_t.severity = error

dotnet_naming_symbols.constants_and_static_readonly.applicable_kinds = field
dotnet_naming_symbols.constants_and_static_readonly.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_naming_rule.constants_are_pascal.symbols = constants_and_static_readonly
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_rule.constants_are_pascal.severity = error
dotnet_naming_rule.static_readonly_are_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_are_pascal.style = pascal
dotnet_naming_rule.static_readonly_are_pascal.severity = error

dotnet_naming_symbols.private_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_rule.private_fields_underscore.symbols = private_internal_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_rule.locals_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_are_camel.style = camel
dotnet_naming_rule.locals_are_camel.severity = error

dotnet_naming_symbols.types_and_members.applicable_kinds = namespace, class, struct, enum, delegate, method, local_function, property, event
dotnet_naming_rule.types_and_members_are_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal.style = pascal
dotnet_naming_rule.types_and_members_are_pascal.severity = error

#### .NET analyzers (code-style §4.5, §4.6, §4.7, §4.9) ####
# Culture: implicit culture in casing, formatting and comparison is an error.
dotnet_diagnostic.CA1304.severity = error
dotnet_diagnostic.CA1305.severity = error
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1311.severity = error
# Logging: message templates only.
dotnet_diagnostic.CA2254.severity = error
# Async: forward cancellation tokens; no ConfigureAwait noise in ASP.NET Core.
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA2007.severity = none
# Design: internal types are sealed unless inheritance is intended.
dotnet_diagnostic.CA1852.severity = warning
# Classes created by dependency injection are reported as never instantiated.
dotnet_diagnostic.CA1812.severity = none
# Banned APIs (BannedSymbols.txt).
dotnet_diagnostic.RS0030.severity = error

#### Meziantou.Analyzer (code-style §4.9) ####
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0026.severity = none
dotnet_diagnostic.MA0051.severity = none
dotnet_diagnostic.MA0006.severity = error
dotnet_diagnostic.MA0011.severity = error
dotnet_diagnostic.MA0042.severity = error
dotnet_diagnostic.MA0048.severity = error
dotnet_diagnostic.MA0074.severity = error
dotnet_diagnostic.MA0076.severity = error
dotnet_diagnostic.MA0040.severity = warning
# Async methods end with Async; other methods do not (naming §4.1).
dotnet_diagnostic.MA0137.severity = warning
dotnet_diagnostic.MA0138.severity = warning

# Generated EF Core migrations are not style-checked.
[**/Migrations/*.cs]
generated_code = true

# Tests (naming §10): method names use underscores and async tests do not end with Async.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.MA0137.severity = none
dotnet_diagnostic.CA1515.severity = none
