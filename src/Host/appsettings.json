{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "PollInterval": "00:00:05",
    "EventLatencyTarget": "00:00:00.300",
    "CleanupSchedule": "0 4 * * *",
    "RetentionPeriod": "30.00:00:00"
  }
}
